# ==============================================================================
# RiskLens AI — Repository Git Ignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Frontend Build & Dependencies
frontend/node_modules/
frontend/dist/
frontend/.tmp/
node_modules/
dist/
*.tsbuildinfo

# Node Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary SQLite & Database Scratch Files
*.db-journal
*.db-wal
*.db-shm
*.db.tmp
data/processed/test_repeatability.db*
data/processed/*.tmp

# Data Directories & Binary Artifacts (Preserve directory structure via .gitkeep)
# Excludes raw CSV and processed SQLite database due to unverified external redistribution license
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.db
*.sqlite
*.sqlite3
